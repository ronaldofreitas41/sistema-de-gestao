generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model mh3_ajudas_motorista {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  funcionario_id   BigInt?           @db.UnsignedBigInt
  equipamento_id   BigInt?           @db.UnsignedBigInt
  data             DateTime?         @db.Date
  tipo_conta       String?           @db.VarChar(50)
  pix              String?           @db.VarChar(150)
  agencia          String?           @db.VarChar(30)
  conta            String?           @db.VarChar(50)
  valor            Decimal?          @default(0.00) @db.Decimal(14, 2)
  status           String?           @default("pendente") @db.VarChar(50)
  observacoes      String?           @db.Text
  criado_em        DateTime          @default(now()) @db.DateTime(0)
  mh3_equipamentos mh3_equipamentos? @relation(fields: [equipamento_id], references: [id], onUpdate: Restrict, map: "fk_ajuda_equipamento")
  mh3_funcionarios mh3_funcionarios? @relation(fields: [funcionario_id], references: [id], onUpdate: Restrict, map: "fk_ajuda_funcionario")

  @@index([equipamento_id], map: "fk_ajuda_equipamento")
  @@index([funcionario_id], map: "fk_ajuda_funcionario")
}

model mh3_alertas {
  id           Int       @id @default(autoincrement())
  tipo         String?   @db.VarChar(50)
  referencia   String?   @db.VarChar(100)
  enviado_em   DateTime? @default(now()) @db.Timestamp(0)
  destinatario String?   @db.VarChar(200)

  @@index([referencia], map: "idx_ref")
}

model mh3_auditoria {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  usuario_id   String?  @db.VarChar(60)
  usuario_nome String?  @db.VarChar(150)
  acao         String?  @db.VarChar(100)
  modulo       String?  @db.VarChar(100)
  registro_id  BigInt?  @db.UnsignedBigInt
  descricao    String?  @db.Text
  ip           String?  @db.VarChar(45)
  criado_em    DateTime @default(now()) @db.DateTime(0)

  @@index([acao], map: "idx_auditoria_acao")
  @@index([criado_em], map: "idx_auditoria_data")
  @@index([modulo], map: "idx_auditoria_modulo")
  @@index([usuario_id], map: "idx_auditoria_usuario")
}

model mh3_backups {
  id         Int       @id @default(autoincrement())
  criado_em  DateTime? @default(now()) @db.Timestamp(0)
  origem     String?   @db.VarChar(150)
  app_versao String?   @db.VarChar(80)
  tamanho    Int?
  conteudo   String?   @db.LongText

  @@index([criado_em], map: "idx_bkp_criado")
}

model mh3_checklist_itens {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  checklist_id   BigInt         @db.UnsignedBigInt
  descricao      String?        @db.VarChar(255)
  status         String?        @db.VarChar(50)
  observacao     String?        @db.Text
  criado_em      DateTime       @default(now()) @db.DateTime(0)
  mh3_checklists mh3_checklists @relation(fields: [checklist_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_checklist_item_checklist")

  @@index([checklist_id], map: "fk_checklist_item_checklist")
}

model mh3_checklists {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  equipamento_id      BigInt?               @db.UnsignedBigInt
  funcionario_id      BigInt?               @db.UnsignedBigInt
  tipo                String?               @db.VarChar(100)
  data                DateTime?             @db.Date
  status              String?               @db.VarChar(50)
  observacoes         String?               @db.Text
  criado_em           DateTime              @default(now()) @db.DateTime(0)
  mh3_checklist_itens mh3_checklist_itens[]
  mh3_equipamentos    mh3_equipamentos?     @relation(fields: [equipamento_id], references: [id], onUpdate: Restrict, map: "fk_checklist_equip")
  mh3_funcionarios    mh3_funcionarios?     @relation(fields: [funcionario_id], references: [id], onUpdate: Restrict, map: "fk_checklist_funcionario")

  @@index([equipamento_id], map: "fk_checklist_equip")
  @@index([funcionario_id], map: "fk_checklist_funcionario")
}

model mh3_clientes {
  id            BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id    BigInt?                   @db.UnsignedBigInt
  tipo_pessoa   mh3_clientes_tipo_pessoa? @default(PJ)
  nome          String                    @db.VarChar(150)
  razao_social  String?                   @db.VarChar(200)
  cpf_cnpj      String?                   @db.VarChar(30)
  email         String?                   @db.VarChar(150)
  telefone      String?                   @db.VarChar(30)
  endereco      String?                   @db.VarChar(255)
  cidade        String?                   @db.VarChar(100)
  estado        String?                   @db.VarChar(2)
  cep           String?                   @db.VarChar(10)
  observacoes   String?                   @db.Text
  ativo         Boolean?                  @default(true)
  criado_em     DateTime                  @default(now()) @db.DateTime(0)
  atualizado_em DateTime                  @default(now()) @db.DateTime(0)
  mh3_empresas  mh3_empresas?             @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_cliente_empresa")
  mh3_contratos mh3_contratos[]
  mh3_propostas mh3_propostas[]
  mh3_vendas    mh3_vendas[]

  @@index([empresa_id], map: "fk_cliente_empresa")
  @@index([cpf_cnpj], map: "idx_cliente_documento")
}

model mh3_config {
  chave         String    @id @db.VarChar(100)
  valor         String?   @db.LongText
  atualizado_em DateTime? @default(now()) @db.Timestamp(0)
  versao        Int       @default(1)
}

model mh3_configuracoes {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id    BigInt?       @db.UnsignedBigInt
  chave         String        @db.VarChar(150)
  valor         String?       @db.Text
  tipo          String?       @default("string") @db.VarChar(30)
  criado_em     DateTime      @default(now()) @db.DateTime(0)
  atualizado_em DateTime      @default(now()) @db.DateTime(0)
  mh3_empresas  mh3_empresas? @relation(fields: [empresa_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_config_empresa")

  @@unique([empresa_id, chave], map: "uk_config_empresa_chave")
}

model mh3_contas_bancarias {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id    BigInt?       @db.UnsignedBigInt
  banco         String?       @db.VarChar(100)
  agencia       String?       @db.VarChar(30)
  conta         String?       @db.VarChar(50)
  tipo          String?       @db.VarChar(50)
  saldo_inicial Decimal?      @default(0.00) @db.Decimal(14, 2)
  saldo_atual   Decimal?      @default(0.00) @db.Decimal(14, 2)
  ativo         Boolean?      @default(true)
  criado_em     DateTime      @default(now()) @db.DateTime(0)
  atualizado_em DateTime      @default(now()) @db.DateTime(0)
  mh3_empresas  mh3_empresas? @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_conta_banco_empresa")

  @@index([empresa_id], map: "fk_conta_banco_empresa")
}

model mh3_contratos {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id       BigInt?            @db.UnsignedBigInt
  cliente_id       BigInt?            @db.UnsignedBigInt
  equipamento_id   BigInt?            @db.UnsignedBigInt
  numero           String?            @db.VarChar(50)
  descricao        String?            @db.Text
  data_inicio      DateTime?          @db.Date
  data_fim         DateTime?          @db.Date
  valor            Decimal?           @default(0.00) @db.Decimal(14, 2)
  status           String?            @default("ativo") @db.VarChar(50)
  ciclo_medicao    String?            @db.VarChar(50)
  observacoes      String?            @db.Text
  criado_em        DateTime           @default(now()) @db.DateTime(0)
  atualizado_em    DateTime           @default(now()) @db.DateTime(0)
  mh3_clientes     mh3_clientes?      @relation(fields: [cliente_id], references: [id], onUpdate: Restrict, map: "fk_contrato_cliente")
  mh3_empresas     mh3_empresas?      @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_contrato_empresa")
  mh3_equipamentos mh3_equipamentos?  @relation(fields: [equipamento_id], references: [id], onUpdate: Restrict, map: "fk_contrato_equipamento")
  mh3_medicoes     mh3_medicoes[]
  mh3_mobilizacoes mh3_mobilizacoes[]

  @@index([empresa_id], map: "fk_contrato_empresa")
  @@index([cliente_id], map: "idx_contrato_cliente")
  @@index([equipamento_id], map: "idx_contrato_equipamento")
  @@index([status], map: "idx_contrato_status")
}

model mh3_dados {
  id            String    @id @db.VarChar(50)
  modulo        String    @db.VarChar(50)
  dados         String    @db.LongText
  criado_em     DateTime? @default(now()) @db.Timestamp(0)
  atualizado_em DateTime? @default(now()) @db.Timestamp(0)

  @@index([criado_em], map: "idx_criado")
  @@index([modulo, criado_em], map: "idx_mod_criado")
}

model mh3_despesas {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id       BigInt?       @db.UnsignedBigInt
  descricao        String?       @db.VarChar(255)
  categoria        String?       @db.VarChar(100)
  fornecedor       String?       @db.VarChar(150)
  documento        String?       @db.VarChar(100)
  data_competencia DateTime?     @db.Date
  data_vencimento  DateTime?     @db.Date
  data_pagamento   DateTime?     @db.Date
  valor            Decimal?      @default(0.00) @db.Decimal(14, 2)
  forma_pagamento  String?       @db.VarChar(100)
  status           String?       @default("pendente") @db.VarChar(50)
  observacoes      String?       @db.Text
  criado_em        DateTime      @default(now()) @db.DateTime(0)
  atualizado_em    DateTime      @default(now()) @db.DateTime(0)
  mh3_empresas     mh3_empresas? @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_despesa_empresa")

  @@index([empresa_id], map: "fk_despesa_empresa")
  @@index([categoria], map: "idx_despesa_categoria")
  @@index([status], map: "idx_despesa_status")
  @@index([data_vencimento], map: "idx_despesa_vencimento")
}

model mh3_email_contas {
  id             String    @id @db.VarChar(60)
  usuario_id     String    @unique(map: "uq_usuario") @db.VarChar(60)
  apelido        String?   @db.VarChar(120)
  remetente      String    @db.VarChar(190)
  nome_remetente String?   @db.VarChar(150)
  host           String    @db.VarChar(190)
  porta          Int       @default(587)
  seg            String?   @default("tls") @db.VarChar(10)
  usuario        String    @db.VarChar(190)
  senha          String    @db.VarChar(255)
  ativo          Boolean?  @default(true)
  criado_em      DateTime? @default(now()) @db.Timestamp(0)
}

model mh3_email_eventos {
  id             Int       @id @default(autoincrement())
  token          String    @unique(map: "uq_token") @db.VarChar(40)
  lancamento_id  String?   @db.VarChar(60)
  tipo           String?   @db.VarChar(40)
  destinatario   String?   @db.VarChar(200)
  assunto        String?   @db.VarChar(300)
  enviado_por    String?   @db.VarChar(120)
  enviado_em     DateTime? @default(now()) @db.Timestamp(0)
  aberto_em      DateTime? @db.DateTime(0)
  confirmado_em  DateTime? @db.DateTime(0)
  ip_abertura    String?   @db.VarChar(60)
  ip_confirmacao String?   @db.VarChar(60)

  @@index([enviado_em], map: "idx_env")
  @@index([lancamento_id], map: "idx_lanc")
}

model mh3_empresas {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  nome                 String                 @db.VarChar(150)
  razao_social         String?                @db.VarChar(200)
  cnpj                 String?                @unique(map: "uk_empresas_cnpj") @db.VarChar(20)
  inscricao_estadual   String?                @db.VarChar(30)
  telefone             String?                @db.VarChar(30)
  email                String?                @db.VarChar(150)
  endereco             String?                @db.VarChar(255)
  cidade               String?                @db.VarChar(100)
  estado               String?                @db.VarChar(2)
  cep                  String?                @db.VarChar(10)
  ativo                Boolean                @default(true)
  criado_em            DateTime               @default(now()) @db.DateTime(0)
  atualizado_em        DateTime               @default(now()) @db.DateTime(0)
  mh3_clientes         mh3_clientes[]
  mh3_configuracoes    mh3_configuracoes[]
  mh3_contas_bancarias mh3_contas_bancarias[]
  mh3_contratos        mh3_contratos[]
  mh3_despesas         mh3_despesas[]
  mh3_equipamentos     mh3_equipamentos[]
  mh3_estoque          mh3_estoque[]
  mh3_funcionarios     mh3_funcionarios[]
  mh3_investimentos    mh3_investimentos[]
  mh3_manutencoes      mh3_manutencoes[]
  mh3_medicoes         mh3_medicoes[]
  mh3_nfs              mh3_nfs[]
  mh3_propostas        mh3_propostas[]
  mh3_sequencias       mh3_sequencias[]
  mh3_vendas           mh3_vendas[]
}

model mh3_equipamentos {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id           BigInt?                @db.UnsignedBigInt
  codigo               String?                @db.VarChar(50)
  placa                String?                @db.VarChar(20)
  frota                String?                @db.VarChar(50)
  tipo                 String?                @db.VarChar(100)
  marca                String?                @db.VarChar(100)
  modelo               String?                @db.VarChar(100)
  ano                  Int?
  renavam              String?                @db.VarChar(30)
  chassi               String?                @db.VarChar(50)
  km_atual             Decimal?               @default(0.00) @db.Decimal(12, 2)
  horimetro            Decimal?               @default(0.00) @db.Decimal(12, 2)
  status               String?                @default("ativo") @db.VarChar(50)
  observacoes          String?                @db.Text
  criado_em            DateTime               @default(now()) @db.DateTime(0)
  atualizado_em        DateTime               @default(now()) @db.DateTime(0)
  mh3_ajudas_motorista mh3_ajudas_motorista[]
  mh3_checklists       mh3_checklists[]
  mh3_contratos        mh3_contratos[]
  mh3_empresas         mh3_empresas?          @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_equip_empresa")
  mh3_manutencoes      mh3_manutencoes[]
  mh3_medicoes         mh3_medicoes[]
  mh3_mobilizacoes     mh3_mobilizacoes[]
  mh3_pneus            mh3_pneus[]
  mh3_pneus_historico  mh3_pneus_historico[]
  mh3_prejuizos        mh3_prejuizos[]
  mh3_revisoes         mh3_revisoes[]
  mh3_saidas_material  mh3_saidas_material[]
  mh3_seguros          mh3_seguros[]

  @@index([empresa_id], map: "fk_equip_empresa")
  @@index([placa], map: "idx_equip_placa")
  @@index([status], map: "idx_equip_status")
}

model mh3_estoque {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id     BigInt?       @db.UnsignedBigInt
  codigo         String?       @db.VarChar(50)
  descricao      String?       @db.VarChar(255)
  categoria      String?       @db.VarChar(100)
  unidade        String?       @default("UN") @db.VarChar(20)
  quantidade     Decimal?      @default(0.000) @db.Decimal(14, 3)
  estoque_minimo Decimal?      @default(0.000) @db.Decimal(14, 3)
  custo_unitario Decimal?      @default(0.00) @db.Decimal(14, 2)
  fornecedor     String?       @db.VarChar(150)
  localizacao    String?       @db.VarChar(150)
  ativo          Boolean?      @default(true)
  criado_em      DateTime      @default(now()) @db.DateTime(0)
  atualizado_em  DateTime      @default(now()) @db.DateTime(0)
  mh3_empresas   mh3_empresas? @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_estoque_empresa")

  @@index([empresa_id], map: "fk_estoque_empresa")
  @@index([categoria], map: "idx_estoque_categoria")
  @@index([codigo], map: "idx_estoque_codigo")
}

model mh3_funcionarios {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id           BigInt?                @db.UnsignedBigInt
  nome                 String                 @db.VarChar(150)
  cpf                  String?                @db.VarChar(20)
  cargo                String?                @db.VarChar(100)
  telefone             String?                @db.VarChar(30)
  email                String?                @db.VarChar(150)
  data_admissao        DateTime?              @db.Date
  salario              Decimal?               @db.Decimal(12, 2)
  ativo                Boolean?               @default(true)
  observacoes          String?                @db.Text
  criado_em            DateTime               @default(now()) @db.DateTime(0)
  atualizado_em        DateTime               @default(now()) @db.DateTime(0)
  mh3_ajudas_motorista mh3_ajudas_motorista[]
  mh3_checklists       mh3_checklists[]
  mh3_empresas         mh3_empresas?          @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_funcionario_empresa")
  mh3_prejuizos        mh3_prejuizos[]
  mh3_saidas_material  mh3_saidas_material[]

  @@index([empresa_id], map: "fk_funcionario_empresa")
  @@index([nome], map: "idx_funcionario_nome")
}

model mh3_investimentos {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id     BigInt?       @db.UnsignedBigInt
  descricao      String?       @db.VarChar(255)
  tipo           String?       @db.VarChar(100)
  data_inicio    DateTime?     @db.Date
  data_fim       DateTime?     @db.Date
  valor_total    Decimal?      @default(0.00) @db.Decimal(14, 2)
  valor_pago     Decimal?      @default(0.00) @db.Decimal(14, 2)
  valor_pendente Decimal?      @default(0.00) @db.Decimal(14, 2)
  status         String?       @db.VarChar(50)
  observacoes    String?       @db.Text
  criado_em      DateTime      @default(now()) @db.DateTime(0)
  mh3_empresas   mh3_empresas? @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_investimento_empresa")

  @@index([empresa_id], map: "fk_investimento_empresa")
}

model mh3_leve {
  id         String    @id @db.VarChar(60)
  modulo     String    @db.VarChar(50)
  dados_leve String    @db.LongText
  src_ts     DateTime? @db.Timestamp(0)

  @@index([modulo], map: "idx_leve_mod")
}

model mh3_local {
  id            String    @id @db.VarChar(120)
  aparelho      String    @db.VarChar(40)
  lista         String    @db.VarChar(60)
  quantos       Int?      @default(0)
  conteudo      String    @db.LongText
  atualizado_em DateTime? @default(now()) @db.Timestamp(0)

  @@index([aparelho], map: "idx_local_ap")
  @@index([lista], map: "idx_local_lista")
}

model mh3_log {
  id             Int       @id @default(autoincrement())
  usuario        String?   @db.VarChar(100)
  acao           String?   @db.VarChar(200)
  modulo         String?   @db.VarChar(50)
  criado_em      DateTime? @default(now()) @db.Timestamp(0)
  usuario_id     String?   @db.VarChar(60)
  usuario_nome   String?   @db.VarChar(150)
  usuario_perfil String?   @db.VarChar(50)
  descricao      String?   @db.Text
  dado_id        String?   @db.VarChar(100)
  dado_antes     String?   @db.LongText
  dado_depois    String?   @db.LongText
  ip             String?   @db.VarChar(45)
  navegador      String?   @db.VarChar(255)
}

model mh3_manutencoes {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id       BigInt?           @db.UnsignedBigInt
  equipamento_id   BigInt?           @db.UnsignedBigInt
  numero_os        String?           @db.VarChar(50)
  tipo             String?           @db.VarChar(100)
  descricao        String?           @db.Text
  data_abertura    DateTime?         @db.Date
  data_fechamento  DateTime?         @db.Date
  km               Decimal?          @db.Decimal(12, 2)
  horimetro        Decimal?          @db.Decimal(12, 2)
  fornecedor       String?           @db.VarChar(150)
  valor_pecas      Decimal?          @default(0.00) @db.Decimal(14, 2)
  valor_mao_obra   Decimal?          @default(0.00) @db.Decimal(14, 2)
  valor_total      Decimal?          @default(0.00) @db.Decimal(14, 2)
  status           String?           @default("aberta") @db.VarChar(50)
  observacoes      String?           @db.Text
  criado_em        DateTime          @default(now()) @db.DateTime(0)
  atualizado_em    DateTime          @default(now()) @db.DateTime(0)
  mh3_empresas     mh3_empresas?     @relation(fields: [empresa_id], references: [id], onUpdate: Restrict, map: "fk_manut_empresa")
  mh3_equipamentos mh3_equipamentos? @relation(fields: [equipamento_id], references: [id], onUpdate: Restrict, map: "fk_manut_equipamento")

  @@index([empresa_id], map: "fk_manut_empresa")
  @@index([data_abertura], map: "idx_manut_data")
  @@index([equipamento_id], map: "idx_manut_equipamento")
  @@index([status], map: "idx_manut_status")
}

model mh3_medicoes {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  empresa_id       BigInt?           @db.UnsignedBigInt
  contrato_id      BigInt?           @db.UnsignedBigInt
  equipamento_id   BigInt?           @db.UnsignedBigInt
  competencia      String?           @db.VarChar(20)
  data_medicao     DateTime?         @db.Date
  km_inicial       Decimal?          @db.Decimal(12, 2)
  km_final         Decimal?          @db.Decimal(12, 2)
  horas_inicial    Decimal?          @db.Decimal(12, 2)
  horas_final      Decimal?          @db.Decimal(12, 2)
  quantidade       Decimal?          @default(0.00) @db.Decimal(14, 2)
  valor_unitario   Decimal?          @default(0.00) @db.Decimal(14, 2)
  valor_total      Decimal?          @default(0.00) @db.Decimal(14, 2)
  status           String?           @default("pendente") @db.VarChar(50)
  observacoes      String?           @db.Text
